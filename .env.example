# Copy this file to .env for local development. .env is gitignored, and app.py
# loads it automatically (see load_dotenv() at the top) — no exporting needed.

# --- Alpaca (live equity/ETF prices) ---------------------------------------
# IMPORTANT: use a SEPARATE key pair here from the one set in Railway's
# production environment variables. Alpaca's free/paper tier allows only ONE
# active websocket stream connection per key pair — if your local .env uses
# the same key as production, both instances fight over that single slot and
# you'll see "connection limit exceeded" errors in the production logs.
# Generate a second pair (a paper-trading key is fine) from your Alpaca
# dashboard and use it here instead.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex

# --- OANDA (live forex/metals prices) ---------------------------------------
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# --- Optional ---------------------------------------------------------------
REDIS_URL=

# --- Local live streams ------------------------------------------------------
# Local runs do NOT open the OANDA/Alpaca streams (they allow ~one connection per
# key, so a dev machine would kick production off). Set to 1 only if this machine
# has its own separate keys.
ENABLE_LIVE_STREAMS_LOCAL=
# Crypto candles come from Coinbase's public API: no key needed.
